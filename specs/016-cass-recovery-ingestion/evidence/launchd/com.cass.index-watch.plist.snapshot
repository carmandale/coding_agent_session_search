<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cass.index-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dalecarman/.local/bin/cass</string>
        <string>index</string>
        <string>--watch</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
