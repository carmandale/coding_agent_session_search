        <key>CASS_FSQLITE_EPROCESS_LAMBDA</key>
        <string>0</string>
        <key>CASS_TANTIVY_WRITER_HEAP_BYTES</key>
        <string>536870912</string>
        <key>PATH</key>
        <string>/Users/dalecarman/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
