#!/bin/sh
#
# br (beads_rust) post-checkout hook — v2.0
#
# Imports updated issues from .beads/issues.jsonl after branch switch.
# Arguments from git: $1=prev HEAD, $2=new HEAD, $3=1 if branch checkout

# Only run on branch checkouts, not file checkouts
if [ "$3" != "1" ]; then
  exit 0
fi

# Guard: skip if br not installed
command -v br >/dev/null 2>&1 || exit 0

# Guard: skip during rebase
git_dir="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
  exit 0
fi

# Guard: resolve .beads/ (worktree-safe)
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
beads_dir="$repo_root/.beads"
if [ ! -d "$beads_dir" ]; then
  common="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
  main_root="$(dirname "$common")"
  beads_dir="$main_root/.beads"
  [ -d "$beads_dir" ] || exit 0
fi

# Import updated JSONL into br database
if ! br sync --import-only --quiet 2>/dev/null; then
  echo "Warning: Failed to import br changes after checkout" >&2
  # Don't fail the checkout, just warn
fi

exit 0
